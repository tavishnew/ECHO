# Server-side Groq API key for the ECHO AI tutor.
# The frontend calls /api/ask (proxied in dev); the key never reaches the browser.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of browser origins allowed to call this API.
# Defaults to http://localhost:5173 when unset.
FRONTEND_URLS=http://localhost:5173

# Set when running behind a reverse proxy (Render, Fly, nginx) so per-IP rate
# limiting sees the real client IP. Value is the number of trusted hops.
# TRUST_PROXY=1
